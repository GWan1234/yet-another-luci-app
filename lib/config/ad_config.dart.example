import 'dart:io';
import 'package:flutter/foundation.dart';

/// Template for AdMob Ad Unit IDs.
/// Copy this file to `lib/config/ad_config.dart` and insert your AdMob Ad Unit IDs.
class AdConfig {
  static const String testAndroidBanner = 'ca-app-pub-3940256099942544/6300978111';
  static const String testAndroidInterstitial = 'ca-app-pub-3940256099942544/1033173712';
  static const String testAndroidRewarded = 'ca-app-pub-3940256099942544/5224354917';
  static const String testAndroidRewardedInterstitial = 'ca-app-pub-3940256099942544/5354046379';
  static const String testAndroidNativeAdvanced = 'ca-app-pub-3940256099942544/2247696110';

  static const String testIosBanner = 'ca-app-pub-3940256099942544/2934735716';
  static const String testIosInterstitial = 'ca-app-pub-3940256099942544/4424256912';
  static const String testIosRewarded = 'ca-app-pub-3940256099942544/1712485313';
  static const String testIosRewardedInterstitial = 'ca-app-pub-3940256099942544/6978759866';
  static const String testIosNativeAdvanced = 'ca-app-pub-3940256099942544/3986624511';

  static String get bannerAdUnitId {
    if (kIsWeb) return testAndroidBanner;
    return Platform.isIOS ? testIosBanner : testAndroidBanner;
  }

  static String get interstitialAdUnitId {
    if (kIsWeb) return testAndroidInterstitial;
    return Platform.isIOS ? testIosInterstitial : testAndroidInterstitial;
  }

  static String get rewardedAdUnitId {
    if (kIsWeb) return testAndroidRewarded;
    return Platform.isIOS ? testIosRewarded : testAndroidRewarded;
  }

  static String get rewardedInterstitialAdUnitId {
    if (kIsWeb) return testAndroidRewardedInterstitial;
    return Platform.isIOS ? testIosRewardedInterstitial : testAndroidRewardedInterstitial;
  }

  static String get nativeAdvancedAdUnitId {
    if (kIsWeb) return testAndroidNativeAdvanced;
    return Platform.isIOS ? testIosNativeAdvanced : testAndroidNativeAdvanced;
  }
}
